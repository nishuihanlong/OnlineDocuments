# 复制为 .env 后按环境修改；禁止把真实密钥提交到版本库
APP_ENV=dev
DEBUG=true

# 开发默认使用 SQLite(aiosqlite)；生产切换到达梦 8 官方方言，详见 docs/backend/database.md
# 已验证可用：同步驱动 dm+dmPython（经线程池门面适配，仅需 dmPython）
#   DATABASE_URL=dm+dmPython://<user>:<password>@<host>:<port>
# 注意：1) 密码里的 @ 必须写成 %40；2) URL 不要带末尾的 /库名 段（达梦不接受 database 参数）
# 原生异步 dm+dmAsync 在 dmSQLAlchemy 2.0.17 + SQLAlchemy 2.0.36 下暂不可用
DATABASE_URL=sqlite+aiosqlite:///./online_documents.db
SQL_ECHO=false

# JWT 签名密钥：生产环境必须设置为高熵随机值
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 首次启动创建的超级管理员密码；留空时自动生成并打印到启动日志
INITIAL_ADMIN_PASSWORD=

# Redis 缓存（留空则使用进程内缓存）
# 标准 URL 格式：redis://[:密码@]host:port/库号，例如 redis://:pwd@127.0.0.1:6379/0
REDIS_URL=

# RabbitMQ 消息队列（留空则不发送领域事件）
# 标准 AMQP URL 格式：amqp://用户:密码@host:port/虚拟主机，例如 amqp://guest:guest@localhost:5672/
RABBITMQ_URL=

# 文档对象存储：local（开发）或 rustfs（S3 兼容）
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
RUSTFS_ENDPOINT=
RUSTFS_BUCKET=documents
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=
